{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkBox",
  "version": "0.1.0",
  "identifier": "com.arkbox.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
      "label": "main",
      "title": "方舟压包",
      "width": 1140,
      "height": 760,
      "minWidth": 880,
      "minHeight": 560,
      "resizable": true,
      "dragDropEnabled": true
    }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["zip", "7z", "tar", "gz", "bz2", "xz", "zst", "tgz", "tbz", "txz", "rar"],
        "name": "Archive",
        "description": "压缩包文件",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist.extra",
      "entitlements": "entitlements.plist"
    }
  }
}
